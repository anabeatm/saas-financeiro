{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .\\mvnw.cmd -o -q spring-boot:run"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "env": { "VITE_API_BASE_URL": "http://localhost:8081" },
      "port": 5173,
      "autoPort": false
    }
  ]
}
